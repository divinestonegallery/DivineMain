# Core Django settings
DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
ALLOWED_HOSTS=divinestonegallery.com,www.divinestonegallery.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://divinestonegallery.com,https://www.divinestonegallery.com

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Clerk authentication
CLERK_SECRET_KEY=replace-with-clerk-secret-key
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev
# Recommended: PEM public key from Clerk Dashboard -> API keys.
CLERK_JWT_KEY=replace-with-clerk-pem-public-key
CLERK_JWT_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=https://divinestonegallery.com,https://www.divinestonegallery.com,http://localhost:3000,http://127.0.0.1:3000
CLERK_JWKS_TIMEOUT_SECONDS=5
CLERK_JWT_LEEWAY_SECONDS=5
CLERK_WEBHOOK_SECRET=replace-with-clerk-webhook-secret
ADMIN_EMAILS=divinestonegallery@gmail.com
CLERK_INVITATION_REDIRECT_URL=https://divinestonegallery.com/sign-up

# Cloudflare R2
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET_NAME=replace-with-r2-bucket
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://your-public-r2-domain.example
R2_UPLOAD_URL_TTL_SECONDS=600
R2_UPLOAD_SESSION_TTL_MINUTES=30
R2_FINALIZATION_TTL_MINUTES=10
R2_MAX_IMAGE_BYTES=10485760
R2_MAX_PRODUCT_IMAGES=12
R2_MIN_IMAGE_WIDTH=400
R2_MIN_IMAGE_HEIGHT=400
R2_MAX_IMAGE_WIDTH=8000
R2_MAX_IMAGE_HEIGHT=8000
R2_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
BACKUP_R2_PREFIX=database-backups
BACKUP_R2_BUCKET_NAME=replace-with-private-backup-bucket
BACKUP_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
ERROR_LOG_RETENTION_DAYS=90
WEBHOOK_EVENT_RETENTION_DAYS=30
UPLOAD_SESSION_RETENTION_DAYS=30

# Security and request limits
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
DATA_UPLOAD_MAX_MEMORY_SIZE=2097152
THROTTLE_ANON_RATE=120/min
THROTTLE_USER_RATE=300/min
THROTTLE_REVIEW_RATE=5/hour
THROTTLE_CONTACT_RATE=5/hour
THROTTLE_CUSTOMIZATION_RATE=3/hour
THROTTLE_UPLOAD_RATE=30/hour
THROTTLE_WEBHOOK_RATE=300/min
LOG_LEVEL=INFO

# External services
EMAIL_API_KEY=replace-with-email-api-key
POSTMAN_API_KEY=replace-with-postman-api-key
